# Consistent line endings
* text=auto

# Infrastructure as Code
*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf

# Scripts
*.sh text eol=lf
*.py text eol=lf

# Documentation
*.md text eol=lf linguist-documentation

# Generated/exported Grafana dashboards
services/grafana/dashboards/*.json text eol=lf linguist-generated

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
