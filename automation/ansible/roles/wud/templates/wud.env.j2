# =============================================================================
# WUD - Environment Configuration
# Managed by Ansible - do not edit manually on dev01
# =============================================================================

# Network
# Address and port on which WUD is exposed on dev01.
WUD_BIND_ADDRESS={{ service_bind_address }}
WUD_PORT=3000

# Persistent data
# Host directory used for WUD's persistent application data.
WUD_DATA_PATH=/srv/appdata/wud

# Timezone
TZ=Europe/Berlin

# Authentication
# Required for WUD 9.x.
# Values are supplied by the Ansible playbook during deployment.
# The actual password must never be committed to Git.
WUD_AUTH_ADMIN_USER={{ wud_admin_user }}
WUD_AUTH_ADMIN_PASSWORD={{ wud_admin_password }}
