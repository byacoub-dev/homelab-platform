# Timezone used inside the container
TZ=Europe/Berlin

# Public or internal URL used to access ntfy
# Adjust this to the domain or hostname of your installation
NTFY_BASE_URL=https://ntfy.example.local

# Base directory for persistent ntfy data on the Docker host
# The compose file creates the subdirectories "cache" and "data" below this path
NTFY_DATA_PATH=/srv/appdata/ntfy
