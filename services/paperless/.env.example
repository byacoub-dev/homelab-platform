# Public or internal URL used to access Paperless-ngx
PAPERLESS_URL=https://paperless.example.local

# Base directory for persistent Paperless-ngx data on the Docker host
PAPERLESS_DATA_PATH=/srv/appdata/paperless

# PostgreSQL database name
PAPERLESS_DB_NAME=paperless

# PostgreSQL database user
PAPERLESS_DB_USER=paperless

# PostgreSQL database password
# Replace this value before starting the stack
PAPERLESS_DB_PASSWORD=change-me
