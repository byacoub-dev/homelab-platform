# AdGuard Home widget
# Use a dedicated technical account.
HOMEPAGE_VAR_ADGUARD_USER=svc_homepage
HOMEPAGE_VAR_ADGUARD_PASS=replace-with-password

# WUD widget (dedicated read-only account)
HOMEPAGE_VAR_WUD_USER=svc_homepage
HOMEPAGE_VAR_WUD_PASS=replace-with-password

# Paperless-ngx widget (dedicated read-only user)
HOMEPAGE_VAR_PAPERLESS_TOKEN=replace-with-api-token

# Proxmox widget (read-only API token)
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=svc_homepage@pve!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=replace-with-token-secret
