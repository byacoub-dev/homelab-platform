---
- Anwendungen:
    - Paperless-ngx:
        icon: paperless-ngx
        href: https://paperless.home.arpa
        description: Dokumentenverwaltung
        widget:
          type: paperlessngx
          url: https://paperless.home.arpa
          key: "{{HOMEPAGE_VAR_PAPERLESS_TOKEN}}"
          fields: ["total", "inbox"]

    - Vaultwarden:
        icon: vaultwarden
        href: https://vault.home.arpa
        description: Passwortverwaltung

- Infrastruktur:
    - AdGuard Home:
        icon: adguard-home
        href: https://adguard.home.arpa
        description: DNS & Werbeblocker
        widget:
          type: adguard
          url: http://adguard:80
          username: "{{HOMEPAGE_VAR_ADGUARD_USER}}"
          password: "{{HOMEPAGE_VAR_ADGUARD_PASS}}"

    - Proxmox:
        icon: proxmox
        href: https://prox10.home.arpa
        description: Virtualisierung · core01
        widget:
          type: proxmox
          url: https://prox10.home.arpa
          username: "{{HOMEPAGE_VAR_PROXMOX_TOKEN_ID}}"
          password: "{{HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET}}"
          fields: ["vms", "lxc", "resources.cpu", "resources.mem"]

    - ntfy:
        icon: ntfy
        href: https://ntfy.home.arpa
        description: Benachrichtigungen

- Monitoring & Operations:
    - Grafana:
        icon: grafana
        href: https://grafana.home.arpa
        description: Dashboards & Observability

    - Prometheus:
        icon: prometheus
        href: https://prometheus.home.arpa
        description: Metriken & Monitoring

    - WUD:
        icon: whats-up-docker
        href: https://updates.home.arpa
        description: Container-Updates
        widget:
          type: whatsupdocker
          url: https://updates.home.arpa
          username: "{{HOMEPAGE_VAR_WUD_USER}}"
          password: "{{HOMEPAGE_VAR_WUD_PASS}}"
          fields: ["monitoring", "updates"]
