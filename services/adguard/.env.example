# IP address of the Docker host used to expose AdGuard Home
# Adjust this to the address of the host running this service
ADGUARD_BIND_ADDRESS=192.168.1.10

# IPv6 address of the Docker host
# Required when IPv6 DNS port bindings are enabled
ADGUARD_BIND_ADDRESS_V6=fd00::10

# Base directory for persistent AdGuard Home data
ADGUARD_DATA_PATH=/srv/appdata/adguard
