          "editorMode": "code",
          "expr": "100 * sum(sum_over_time(probe_success{job=\"blackbox-http\",service=~\"$service\"}[7d])) / sum(count_over_time(probe_success{job=\"blackbox-http\",service=~\"$service\"}[7d]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
