      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {
              "service": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "Status",
              "Value #B": "HTTP",
              "Value #C": "Antwortzeit",
              "Value #D": "HTTPS",
              "Value #E": "24 h (%)",
              "Value #F": "7 T. (%)"
            }
          }
        }
      ],
      "description": "UP/DOWN, HTTP, Gesamt-Probe-Dauer und tatsächlich beobachtete Erfolgsquote der letzten 24 h / 7 Tage. Bei neuer Installation gilt die Quote nur für bisher vorhandene Messpunkte; kein 24/7-SLA-Nachweis."
    },
    {
      "id": 8,
      "title": "Antwortzeiten · Verlauf",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "probe_duration_seconds{job=\"blackbox-http\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "description": "Gesamtdauer der HTTP-Blackbox-Probe je Service; rote bzw. orange Warnschwellen sind keine universellen SLAs."
    },
