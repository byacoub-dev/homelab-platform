        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "probe_http_ssl{job=\"blackbox-http\",service=~\"$service\"}",
          "legendFormat": "{{service}}",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * avg_over_time(probe_success{job=\"blackbox-http\",service=~\"$service\"}[24h])",
          "legendFormat": "{{service}}",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * avg_over_time(probe_success{job=\"blackbox-http\",service=~\"$service\"}[7d])",
          "legendFormat": "{{service}}",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
