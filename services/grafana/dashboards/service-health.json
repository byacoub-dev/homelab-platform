              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Anteil erfolgreicher Probes in den letzten 7 Tagen, gewichtet nach tatsächlich vorhandenen Messpunkten. Bei kürzerer Historie nur erfasster Teilzeitraum!"
    },
    {
      "id": 6,
      "title": "Ø Probe-Dauer",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "avg(probe_duration_seconds{job=\"blackbox-http\",service=~\"$service\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
