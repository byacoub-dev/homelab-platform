      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\",service=~\"$service\"} - time()) / 3600",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
