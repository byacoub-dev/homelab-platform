# IP address Grafana binds to on the host.
# Use 127.0.0.1 for local-only access or a specific LAN IP if a reverse proxy on another host needs access.
GRAFANA_BIND_IP=change-me

# Initial Grafana administrator username.
GRAFANA_ADMIN_USER=admin

# Initial Grafana administrator password.
# Replace this value before starting the container.
GRAFANA_ADMIN_PASSWORD=change-me
